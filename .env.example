# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend runtime provider (Supabase-only)
VITE_DATA_PROVIDER=supabase

# Auth provider (Supabase-only runtime)
VITE_AUTH_PROVIDER=supabase

# Permissions provider (Supabase-only runtime)
VITE_PERMISSIONS_DATA_PROVIDER=supabase

# Sessions provider (Supabase-only runtime)
VITE_SESSIONS_DATA_PROVIDER=supabase

# Supabase configuration (used only when VITE_DATA_PROVIDER=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local-only administrative URL/key for manual auth migration scripts.
# Never expose these in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only Firebase Admin credentials for reading Firebase Auth users.
# Use either FIREBASE_SERVICE_ACCOUNT_JSON or the three FIREBASE_ADMIN_* values.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only administrative key for the manual sessions migration script.
# Never expose this value in frontend code or commit a real key.
# (Already defined above; keep one shared value for all local admin scripts.)

# Optional bootstrap for Phase 3: if true and Supabase sessions table is empty,
# app will seed sessions once from Firebase sessions collection.
VITE_SUPABASE_AUTO_MIGRATE_SESSIONS=false
