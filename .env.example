# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase configuration — copy to .env and fill in real values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Data provider switch: firebase | supabase
VITE_DATA_PROVIDER=firebase

# Auth provider switch during migration. Defaults to supabase when configured.
VITE_AUTH_PROVIDER=supabase

# Permissions provider switch during migration. Defaults to auth provider.
VITE_PERMISSIONS_DATA_PROVIDER=supabase

# Sessions provider switch for the session module only: firebase | supabase
VITE_SESSIONS_DATA_PROVIDER=firebase

# Supabase configuration (used only when VITE_DATA_PROVIDER=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only administrative key for the manual sessions migration script.
# Never expose this value in frontend code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bootstrap for Phase 3: if true and Supabase sessions table is empty,
# app will seed sessions once from Firebase sessions collection.
VITE_SUPABASE_AUTO_MIGRATE_SESSIONS=false
