{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate:auth": "tsx scripts/migrate-firebase-auth-to-supabase.ts",
    "migrate:sessions": "tsx scripts/migrate-sessions-firebase-to-supabase.ts",
    "migrate:squad": "tsx scripts/migrate-firestore-domain.ts squad",
    "migrate:attendance": "tsx scripts/migrate-firestore-domain.ts attendance",
    "migrate:exercises": "tsx scripts/migrate-firestore-domain.ts exercises",
    "migrate:exercise-deleted-ids": "tsx scripts/migrate-firestore-domain.ts exercise-deleted-ids",
    "migrate:fixtures": "tsx scripts/migrate-firestore-domain.ts fixtures",
    "migrate:video": "tsx scripts/migrate-firestore-domain.ts video",
    "migrate:team-logo": "tsx scripts/migrate-firestore-domain.ts team-logo",
    "migrate:session-cards": "tsx scripts/migrate-firestore-domain.ts session-cards",
    "migrate:permissions": "tsx scripts/migrate-firestore-domain.ts permissions",
    "migrate:all-domains": "npm run migrate:permissions && npm run migrate:squad && npm run migrate:attendance && npm run migrate:team-logo && npm run migrate:exercises && npm run migrate:exercise-deleted-ids && npm run migrate:session-cards && npm run migrate:fixtures && npm run migrate:video",
    "backfill:user-profiles": "tsx scripts/backfill-user-profiles-from-auth.ts",
    "stepA:report-exercise-modules": "tsx scripts/report-exercise-module-classification.ts",
    "stepA:report-exercise-modules:apply": "tsx scripts/report-exercise-module-classification.ts --apply",
    "stepA:preflight-snapshot": "tsx scripts/stepA-preflight-snapshot.ts",
    "stepA:backfill-fitness": "tsx scripts/backfill-fitness-sessions-from-legacy.ts",
    "stepA:backfill-fitness:dry": "tsx scripts/backfill-fitness-sessions-from-legacy.ts --dry-run",
    "stepA:validate-fitness-backfill": "tsx scripts/validate-fitness-backfill.ts",
    "stepB:backfill-gk": "tsx scripts/backfill-gk-sessions-from-legacy.ts",
    "stepB:backfill-gk:dry": "tsx scripts/backfill-gk-sessions-from-legacy.ts --dry-run",
    "stepB:validate-gk-backfill": "tsx scripts/validate-gk-backfill.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-player": "^3.4.0",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
